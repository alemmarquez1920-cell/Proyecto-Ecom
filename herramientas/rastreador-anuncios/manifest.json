{
  "manifest_version": 3,
  "name": "Rastreador de Anuncios",
  "version": "1.0.0",
  "description": "Encontrá marcas que están escalando en la Biblioteca de anuncios de Meta: activos por marca, nuevos en 90 días y su historial.",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.facebook.com/ads/library*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icono-16.png",
    "48": "icono-48.png",
    "128": "icono-128.png"
  },
  "short_name": "Rastreador"
}